<mah:MetroWindow x:Class="ElectronicLoadTester.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="하드웨어 엔지니어링 설정 및 수동 진단" 
                 Height="680" Width="1000"
                 MinHeight="600" MinWidth="850"
                 WindowStartupLocation="CenterOwner"
                 Background="#F8FAFC"
                 Foreground="#0F172A"
                 FontFamily="Segoe UI, Malgun Gothic">

    <Window.Resources>
        <!-- 카드 스타일 -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="46"/>
        </Grid.RowDefinitions>

        <mah:MetroAnimatedTabControl Grid.Row="0" Background="Transparent" BorderThickness="0">

            <!-- [탭 1: 직렬 통신 포트 설정] -->
            <TabItem Header="통신 포트 (COM Port)" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- OWON 포트 -->
                    <Border Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="OWON DC 파워서플라이" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <TextBlock Text="COM 포트" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableComPorts}" SelectedItem="{Binding OwonComPort}" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="통신 속도 (BaudRate)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="0" Height="34" Margin="0,0,16,0">
                                <ComboBoxItem Content="115200"/>
                                <ComboBoxItem Content="9600"/>
                            </ComboBox>

                            <Button Command="{Binding ConnectOwonCommand}" Content="연결 테스트" Style="{StaticResource OutlineBtn}"/>
                        </StackPanel>
                    </Border>

                    <!-- Rigol 포트 -->
                    <Border Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Rigol 전자부하기" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <TextBlock Text="COM 포트" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableComPorts}" SelectedItem="{Binding RigolComPort}" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="통신 속도 (BaudRate)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="0" Height="34" Margin="0,0,16,0">
                                <ComboBoxItem Content="115200"/>
                                <ComboBoxItem Content="9600"/>
                            </ComboBox>

                            <Button Command="{Binding ConnectRigolCommand}" Content="연결 테스트" Style="{StaticResource OutlineBtn}"/>
                        </StackPanel>
                    </Border>

                    <!-- RS-485 릴레이 포트 -->
                    <Border Grid.Column="2" Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="RS-485 릴레이 보드" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <TextBlock Text="COM 포트" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableComPorts}" SelectedItem="{Binding RelayComPort}" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="통신 속도 (BaudRate)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <ComboBox SelectedIndex="1" Height="34" Margin="0,0,16,0">
                                <ComboBoxItem Content="115200"/>
                                <ComboBoxItem Content="9600"/>
                            </ComboBox>

                            <Button Command="{Binding ConnectRelayCommand}" Content="연결 테스트" Style="{StaticResource OutlineBtn}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- [탭 2: 수동 장비 개별 진단 및 제어] -->
            <TabItem Header="수동 장비 진단" FontSize="13" FontWeight="SemiBold">
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- OWON 수동 제어 -->
                    <Border Grid.Column="0" Style="{StaticResource SettingCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="OWON 파워 수동 인가" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="전압 설정 (V)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <mah:NumericUpDown Value="{Binding ManualPowerSetVoltage}" Minimum="0" Maximum="60" Interval="0.1" StringFormat="F3" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="전류 한도 (A)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <mah:NumericUpDown Value="{Binding ManualPowerSetCurrent}" Minimum="0" Maximum="10" Interval="0.05" StringFormat="F3" Height="34" Margin="0,0,0,14"/>

                            <Button Command="{Binding ApplyPowerSettingsCommand}" Content="설정값 즉시 전송" Background="#2563EB" Foreground="White" Height="34" Margin="0,0,0,12"/>
                            <mah:ToggleSwitch Header="출력단 (OUTPUT)" IsOn="{Binding ManualPowerOutputEnabled}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Rigol 수동 제어 -->
                    <Border Grid.Column="1" Style="{StaticResource SettingCard}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="Rigol 부하기 수동 흡수" FontWeight="Bold" Margin="0,0,0,12"/>

                            <TextBlock Text="CC 흡수 전류 (A)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <mah:NumericUpDown Value="{Binding ManualLoadSetCurrent}" Minimum="0" Maximum="30" Interval="0.1" StringFormat="F4" Height="34" Margin="0,0,0,10"/>

                            <TextBlock Text="CV 단자 전압 (V)" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                            <mah:NumericUpDown Value="{Binding ManualLoadSetVoltage}" Minimum="0" Maximum="150" Interval="0.5" StringFormat="F4" Height="34" Margin="0,0,0,14"/>

                            <Button Command="{Binding ApplyLoadSettingsCommand}" Content="부하값 즉시 적용" Background="#2563EB" Foreground="White" Height="34" Margin="0,0,0,12"/>
                            <mah:ToggleSwitch Header="입력단 (SINK INPUT)" IsOn="{Binding ManualLoadInputEnabled}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- 485 릴레이 수동 절환 -->
                    <Border Grid.Column="2" Style="{StaticResource SettingCard}">
                        <StackPanel>
                            <TextBlock Text="485 릴레이 채널 강제 전환" FontWeight="Bold" Margin="0,0,0,12"/>
                            <TextBlock Text="시험 채널 선택" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>

                            <Button Content="5V 채널 선택 (B1-CH1)" Command="{Binding SelectChannelRelayCommand}" CommandParameter="5V" Style="{StaticResource OutlineBtn}" Height="36" Margin="0,0,0,6"/>
                            <Button Content="24V 채널 선택 (B1-CH2)" Command="{Binding SelectChannelRelayCommand}" CommandParameter="24V" Style="{StaticResource OutlineBtn}" Height="36" Margin="0,0,0,6"/>
                            <Button Content="30V 채널 선택 (B1-CH3)" Command="{Binding SelectChannelRelayCommand}" CommandParameter="30V" Style="{StaticResource OutlineBtn}" Height="36" Margin="0,0,0,14"/>

                            <Button Content="전체 릴레이 차단 (OFF)" Command="{Binding SelectChannelRelayCommand}" CommandParameter="ALL_OFF" Background="#EF4444" Foreground="White" Height="36"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </mah:MetroAnimatedTabControl>

        <!-- 닫기 버튼 -->
        <Button Grid.Row="1" Content="닫기" Command="{Binding CloseSettingsCommand}" Width="100" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource OutlineBtn}"/>
    </Grid>
</mah:MetroWindow>