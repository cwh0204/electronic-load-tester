<mah:MetroWindow x:Class="ElectronicLoadTester.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 mc:Ignorable="d"
                 Title="시스템 검사 기준 사양 설정 (모듈별 / 레일별)" 
                 Height="650" Width="800"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 Background="#F8FAFC"
                 Foreground="#0F172A"
                 FontFamily="Segoe UI, Malgun Gothic"
                 GlowBrush="#CBD5E1">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 카드 스타일 -->
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- 필드 라벨 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 세그먼트 라디오버튼 공통 스타일 -->
        <Style x:Key="SegmentRadioButton" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="6,5" Margin="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <!-- 0: 상단 헤더 타이틀 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: 1계층 시험 대상 모듈 6종 선택 바 -->
            <RowDefinition Height="Auto"/>
            <!-- 2: 2계층 시험 출력 레일 4종 선택 바 -->
            <RowDefinition Height="Auto"/>
            <!-- 3: 세부 사양 입력 2분할 카드 (지속 부하 / 차단 시험) -->
            <RowDefinition Height="*"/>
            <!-- 4: 하단 적용 및 닫기 버튼 도크 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- [0] 상단 헤더 타이틀 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Width="28" Height="28" Margin="0,0,8,0">
                    <iconPacks:PackIconMaterial Kind="Tune" Width="14" Height="14" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="모듈별 / 레일별 검사 사양 설정" FontSize="14" FontWeight="Black" Foreground="#0F172A"/>
                    <TextBlock Text="설정할 대상 모듈과 출력 레일을 선택하여 판정 기준 사양을 변경합니다." FontSize="10.5" Foreground="#64748B"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- [1] 1계층: 시험 대상 모듈 6종 선택 세그먼트 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <DockPanel Margin="2,0,2,4">
                <TextBlock Text="1. 설정 대상 모듈 선택" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                <TextBlock Text="{Binding SelectedTargetSystem, StringFormat='선택됨: {0}'}" FontSize="10.5" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border Background="#F1F5F9" CornerRadius="8" Padding="3" BorderBrush="#E2E8F0" BorderThickness="1">
                <UniformGrid Columns="6">
                    <RadioButton Content="TCMS-CC" GroupName="SettingsModuleGroup" IsChecked="{Binding IsTargetTcmsCc}" Command="{Binding ChangeTargetSystemCommand}" CommandParameter="TCMS-CC" Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="TCMS-TC" GroupName="SettingsModuleGroup" IsChecked="{Binding IsTargetTcmsTc}" Command="{Binding ChangeTargetSystemCommand}" CommandParameter="TCMS-TC" Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="CI-123"  GroupName="SettingsModuleGroup" IsChecked="{Binding IsTargetCi123}"  Command="{Binding ChangeTargetSystemCommand}" CommandParameter="CI-123"  Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="CI-4"    GroupName="SettingsModuleGroup" IsChecked="{Binding IsTargetCi4}"    Command="{Binding ChangeTargetSystemCommand}" CommandParameter="CI-4"    Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="SIV-123" GroupName="SettingsModuleGroup" IsChecked="{Binding IsTargetSiv123}" Command="{Binding ChangeTargetSystemCommand}" CommandParameter="SIV-123" Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="SIV-4"   GroupName="SettingsModuleGroup" IsChecked="{Binding IsTargetSiv4}"   Command="{Binding ChangeTargetSystemCommand}" CommandParameter="SIV-4"   Style="{StaticResource SegmentRadioButton}"/>
                </UniformGrid>
            </Border>
        </StackPanel>

        <!-- [2] 2계층: 해당 모듈의 출력 레일 선택 세그먼트 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <DockPanel Margin="2,0,2,4">
                <TextBlock Text="2. 출력 레일 선택" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                <TextBlock Text="*선택된 모듈의 지원 레일만 활성화됩니다" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </DockPanel>
            <Border Background="#F1F5F9" CornerRadius="8" Padding="3" BorderBrush="#E2E8F0" BorderThickness="1">
                <UniformGrid Columns="4">
                    <RadioButton Content="5V 레일 규격"  GroupName="SettingsRailGroup" IsChecked="{Binding Is5VSelected}"  IsEnabled="{Binding Is5VSupported}"  Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="24V 레일 규격" GroupName="SettingsRailGroup" IsChecked="{Binding Is24VSelected}" IsEnabled="{Binding Is24VSupported}" Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="30V 레일 규격" GroupName="SettingsRailGroup" IsChecked="{Binding Is30VSelected}" IsEnabled="{Binding Is30VSupported}" Style="{StaticResource SegmentRadioButton}"/>
                    <RadioButton Content="48V 레일 규격" GroupName="SettingsRailGroup" IsChecked="{Binding Is48VSelected}" IsEnabled="{Binding Is48VSupported}" Style="{StaticResource SegmentRadioButton}"/>
                </UniformGrid>
            </Border>
        </StackPanel>

        <!-- [3] 3계층: 선택된 모듈/레일의 세부 사양 입력 카드 (좌/우 2분할) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 좌측: 지속 부하 시험 사양 (CC / CV) -->
            <Border Grid.Column="0" Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="ENDURANCE" FontSize="9" FontWeight="Black" Foreground="#2563EB"/>
                        </Border>
                        <TextBlock Text="지속 부하 시험 판정 사양" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- CC 모드 설정 박스 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="■ CC (정전류 모드) 설정" FontSize="11" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="인가 전류 (A)" Style="{StaticResource FieldLabel}"/>
                                    <mah:NumericUpDown Visibility="{Binding Is5VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec5V_CcCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is24VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec24V_CcCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is30VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec30V_CcCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is48VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec48V_CcCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="최저 전압 (V)" Style="{StaticResource FieldLabel}"/>
                                    <mah:NumericUpDown Visibility="{Binding Is5VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec5V_CcMinVolt, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="20" Interval="0.05" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is24VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec24V_CcMinVolt, UpdateSourceTrigger=PropertyChanged}" Minimum="5.0" Maximum="40" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is30VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec30V_CcMinVolt, UpdateSourceTrigger=PropertyChanged}" Minimum="5.0" Maximum="50" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is48VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec48V_CcMinVolt, UpdateSourceTrigger=PropertyChanged}" Minimum="10.0" Maximum="70" Interval="0.1" StringFormat="F2" Height="30"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CV 모드 설정 박스 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="■ CV (정전압 모드) 설정" FontSize="11" FontWeight="Bold" Foreground="#0D9488" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="인가 전압 (V)" Style="{StaticResource FieldLabel}"/>
                                    <mah:NumericUpDown Visibility="{Binding Is5VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec5V_CvVolt, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="20" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is24VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec24V_CvVolt, UpdateSourceTrigger=PropertyChanged}" Minimum="5.0" Maximum="40" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is30VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec30V_CvVolt, UpdateSourceTrigger=PropertyChanged}" Minimum="5.0" Maximum="50" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is48VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec48V_CvVolt, UpdateSourceTrigger=PropertyChanged}" Minimum="10.0" Maximum="70" Interval="0.1" StringFormat="F2" Height="30"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="최저 전류 (A)" Style="{StaticResource FieldLabel}"/>
                                    <mah:NumericUpDown Visibility="{Binding Is5VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec5V_CvMinCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is24VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec24V_CvMinCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is30VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec30V_CvMinCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is48VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec48V_CvMinCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 우측: 차단 시험 판정 사양 (시작값 / 트립값 독립 입력 구조) -->
            <Border Grid.Column="2" Style="{StaticResource SettingCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <Border Background="#FEE2E2" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="TRIP LIMIT" FontSize="9" FontWeight="Black" Foreground="#DC2626"/>
                        </Border>
                        <TextBlock Text="차단 시험 판정 사양 (OCP / OVP)" FontSize="12" FontWeight="Bold" Foreground="#991B1B" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- 1. CC 과전류 차단 (OCP): 시작 전류(A) + 목표 트립 전류(A) -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="■ CC 과전류 차단 (OCP) 설정" FontSize="11" FontWeight="Bold" Foreground="#DC2626"/>
                                <Border Background="#FEE2E2" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                    <TextBlock Text="CC 모드용" FontSize="9.5" FontWeight="Bold" Foreground="#B91C1C"/>
                                </Border>
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 시작 전류 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="시작 전류 (A)" Style="{StaticResource FieldLabel}"/>
                                    <mah:NumericUpDown Visibility="{Binding Is5VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec5V_OcpStartCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is24VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec24V_OcpStartCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is30VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec30V_OcpStartCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is48VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec48V_OcpStartCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.1" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                </StackPanel>

                                <!-- 목표 트립 전류 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="목표 트립 전류 (A)" Style="{StaticResource FieldLabel}"/>
                                    <mah:NumericUpDown Visibility="{Binding Is5VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec5V_TripCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is24VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec24V_TripCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is30VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec30V_TripCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is48VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec48V_TripCurrent, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="30" Interval="0.1" StringFormat="F2" Height="30"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="* 판정: 목표 트립 전류의 ±15% 범위 내 셧다운 시 합격" FontSize="9.5" Foreground="#B91C1C"/>
                        </StackPanel>
                    </Border>

                    <!-- 2. CV 과전압 차단 (OVP): 시작 전압(V) + 목표 트립 전압(V) -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="■ CV 과전압 차단 (OVP) 설정" FontSize="11" FontWeight="Bold" Foreground="#0D9488"/>
                                <Border Background="#CCFBF1" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                    <TextBlock Text="CV 모드용" FontSize="9.5" FontWeight="Bold" Foreground="#0F766E"/>
                                </Border>
                            </DockPanel>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 시작 전압 -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="시작 전압 (V)" Style="{StaticResource FieldLabel}"/>
                                    <mah:NumericUpDown Visibility="{Binding Is5VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec5V_OvpStartVoltage, UpdateSourceTrigger=PropertyChanged}" Minimum="0.5" Maximum="25" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is24VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec24V_OvpStartVoltage, UpdateSourceTrigger=PropertyChanged}" Minimum="5.0" Maximum="45" Interval="0.2" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is30VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec30V_OvpStartVoltage, UpdateSourceTrigger=PropertyChanged}" Minimum="5.0" Maximum="55" Interval="0.2" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is48VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec48V_OvpStartVoltage, UpdateSourceTrigger=PropertyChanged}" Minimum="10.0" Maximum="75" Interval="0.5" StringFormat="F2" Height="30"/>
                                </StackPanel>

                                <!-- 목표 트립 전압 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="목표 트립 전압 (V)" Style="{StaticResource FieldLabel}"/>
                                    <mah:NumericUpDown Visibility="{Binding Is5VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec5V_TripVoltage, UpdateSourceTrigger=PropertyChanged}" Minimum="1.0" Maximum="25" Interval="0.1" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is24VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec24V_TripVoltage, UpdateSourceTrigger=PropertyChanged}" Minimum="10.0" Maximum="45" Interval="0.2" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is30VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec30V_TripVoltage, UpdateSourceTrigger=PropertyChanged}" Minimum="15.0" Maximum="55" Interval="0.2" StringFormat="F2" Height="30"/>
                                    <mah:NumericUpDown Visibility="{Binding Is48VSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Value="{Binding Spec48V_TripVoltage, UpdateSourceTrigger=PropertyChanged}" Minimum="20.0" Maximum="75" Interval="0.5" StringFormat="F2" Height="30"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="* 판정: 목표 트립 전압의 ±15% 범위 내 셧다운시 합격" FontSize="9.5" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- [4] 하단 적용 및 닫기 버튼 도크 -->
        <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="적용 및 닫기" 
                        Command="{Binding CloseSettingsCommand}" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="120" Height="36" 
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
