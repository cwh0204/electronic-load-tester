<mah:MetroWindow x:Class="ElectronicLoadTester.Views.ResultSearchWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:oxy="http://oxyplot.org/wpf"
                 mc:Ignorable="d"
                 Title="검사 결과 이력 검색 및 파형 복원"
                 Width="1360" Height="820"
                 WindowStartupLocation="CenterOwner"
                 Background="#F8FAFC"
                 Foreground="#0F172A"
                 FontFamily="Segoe UI, Malgun Gothic"
                 GlowBrush="#CBD5E1">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- 카드 스타일 -->
        <Style x:Key="SearchCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- 아웃라인 버튼 -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource MahApps.Styles.Button.Square}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: 상단 필터 바 -->
            <RowDefinition Height="Auto"/>
            <!-- 1: 메인 본문 (좌측 목록 + 우측 상세/차트) -->
            <RowDefinition Height="*"/>
            <!-- 2: 하단 상태바 -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ================= 0. 상단 검색 조건 필터 바 ================= -->
        <Border Grid.Row="0" Style="{StaticResource SearchCard}" Margin="0,0,0,12" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- 0: 기간 조회 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 1: 시스템 필터 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 2: 최종 판정 필터 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 3: 검색어 입력 (남은 공간을 시원하게 채움) -->
                    <ColumnDefinition Width="*"/>
                    <!-- 4: 우측 버튼 영역 -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 0. 기간 조회 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="검사 기간" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="30"/>
                    <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="30"/>
                </StackPanel>

                <!-- 1. 시스템 필터 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="시스템" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding TargetSystemOptions}" SelectedItem="{Binding SelectedTargetSystem}" Width="90" Height="30"/>
                </StackPanel>

                <!-- 2. 판정 필터 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="최종 판정" FontSize="11" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ComboBox ItemsSource="{Binding VerdictOptions}" SelectedItem="{Binding SelectedVerdict}" Width="85" Height="30"/>
                </StackPanel>

                <!-- 3. 검색어 입력 (사방 테두리 적용 + 우측 버튼까지 자연스럽게 확장) -->
                <Grid Grid.Column="3" Margin="0,0,16,0">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                     mah:TextBoxHelper.Watermark="시리얼 번호 / 비고 검색" 
                     mah:TextBoxHelper.ClearTextButton="True"
                     Height="30"
                     BorderBrush="#CBD5E1"
                     BorderThickness="1"
                     Padding="8,0"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- 4. 우측 버튼 영역 -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SearchCommand}" Style="{StaticResource MahApps.Styles.Button.Square.Accent}" 
                    Background="#2563EB" BorderBrush="#1D4ED8" Height="32" Padding="14,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="조회" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource ToolButton}" Foreground="#DC2626" BorderBrush="#FECACA">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="TrashCanOutline" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="선택 삭제" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 1. 메인 본문 (좌측: 마스터 리스트 / 우측: 상세 + 차트) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- 좌측 이력 목록 (520px 고정) -->
                <ColumnDefinition Width="520"/>
                <!-- 우측 상세 스텝 및 파형 (가변) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- [좌측] 검사 마스터 이력 그리드 -->
            <Border Grid.Column="0" Style="{StaticResource SearchCard}" Margin="0,0,12,0" Padding="0">
                <DataGrid ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedMaster}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          Background="#FFFFFF" BorderThickness="0" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                          RowHeight="36" FontSize="11" SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시리얼 번호" Binding="{Binding SerialNumber}" Width="150"/>
                        <DataGridTextColumn Header="대상" Binding="{Binding TargetSystem}" Width="55"/>
                        <DataGridTextColumn Header="레일" Binding="{Binding RailName}" Width="50"/>
                        <DataGridTextColumn Header="모드" Binding="{Binding TestMode}" Width="50"/>

                        <!-- 판정 뱃지 -->
                        <DataGridTemplateColumn Header="판정" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FinalVerdict}" Value="PASS">
                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding FinalVerdict}" Value="FAIL">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding FinalVerdict}" FontWeight="Bold" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FinalVerdict}" Value="PASS">
                                                            <Setter Property="Foreground" Value="#047857"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding FinalVerdict}" Value="FAIL">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="검사 일시" Binding="{Binding TestedAt}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- [우측] 상단: 상세 측정 스텝 표 / 하단: 복원된 OxyPlot 시계열 파형 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- 상단 상세 스텝 (190px) -->
                    <RowDefinition Height="190"/>
                    <!-- 하단 파형 차트 (가변) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 상단: 선택된 검사의 상세 스텝 결과표 -->
                <Border Grid.Row="0" Style="{StaticResource SearchCard}" Margin="0,0,0,10" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6">
                            <iconPacks:PackIconMaterial Kind="FormatListBulleted" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="세부 스텝 측정 결과" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                            <TextBlock Text="{Binding SelectedMaster.SerialNumber, StringFormat='{} - [{0}]'}" FontSize="11" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedMasterSteps}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  Background="#FFFFFF" BorderThickness="0" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="32" FontSize="11">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="스텝" Binding="{Binding StepNo}" Width="50"/>
                                <DataGridTextColumn Header="검사 항목" Binding="{Binding StepName}" Width="150"/>
                                <DataGridTextColumn Header="모드" Binding="{Binding Mode}" Width="55"/>
                                <DataGridTextColumn Header="인가 조건" Binding="{Binding TargetCondition}" Width="110"/>
                                <DataGridTextColumn Header="판정 기준" Binding="{Binding SpecRange}" Width="120"/>
                                <DataGridTextColumn Header="측정 전압" Binding="{Binding MeasuredVoltage, StringFormat='{}{0:F3} V'}" Width="100"/>
                                <DataGridTextColumn Header="측정 전류" Binding="{Binding MeasuredCurrent, StringFormat='{}{0:F3} A'}" Width="100"/>
                                <DataGridTextColumn Header="판정" Binding="{Binding Result}" Width="70"/>
                                <DataGridTextColumn Header="수행 시각" Binding="{Binding ExecutedAt}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 하단: 시계열 그래프 파형 복원 영역 -->
                <Border Grid.Row="1" Style="{StaticResource SearchCard}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,0,4,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Kind="ChartTimelineVariant" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="검사 당시 V-I 파형 복원" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#2563EB" Width="10" Height="3" Margin="0,0,4,0"/>
                                <TextBlock Text="출력 전압 (V)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,14,0"/>
                                <Border Background="#F59E0B" Width="10" Height="3" Margin="0,0,4,0"/>
                                <TextBlock Text="부하 전류 (A)" FontSize="10" FontWeight="SemiBold" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>

                        <oxy:PlotView Grid.Row="1" Model="{Binding HistoryPlotModel}" Background="#F8FAFC"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= 2. 하단 상태 바 ================= -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="-16,0,-16,-16" Padding="16,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</mah:MetroWindow>